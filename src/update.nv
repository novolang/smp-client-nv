// update: `novo update`, the command that updates a board over SMP.
//
//   novo update [--target BOARD] [LINK] [OPTIONS] FILE
//   novo update [--target BOARD] [LINK] [OPTIONS] VERB [ARGUMENTS]
//   novo update scan [--target BOARD] [--serial | --ble]
//
// LINK says how the board is reached:
//
//   --serial [PORT]   the board's serial port, in the console framing of SMP.  Without a PORT the
//                     serial ports of attached USB boards are listed, and the one there is, is used.
//   --ble [ADDRESS]   the SMP service of a device over Bluetooth Low Energy, through a relay
//                     program that has a Controller (noble-examples' pc/ble_smp.nv).  Without an
//                     ADDRESS the relay scans for devices that advertise the service, the devices
//                     are listed, and the one there is, is used.
//   --tcp HOST:PORT   a server on a socket, such as mcumgr-nv's host server.
//
// A FILE alone is an upload to the second slot: a NOVB image (`novo build --role=application`
// writes `<name>.img`) or the package `novo image pack` writes.  The VERBs:
//
//   upload FILE       the same, said out
//   data FILE         the file `novofs-tools mk --target` wrote, into the data region (image 1)
//   list              the images the board holds
//   test HASH         marks the image with the hash (hex) for a trial at the next start
//   confirm [HASH]    confirms the image that runs, or makes the staged one permanent
//   reset             the board restarts
//   erase             erases the second slot
//   params, echo TEXT what the server answers about itself; a check of the link
//   file up LOCAL NAME | file down NAME LOCAL | file status NAME | file hash NAME | file close
//                     the files of the board's volume, as far as the server offers them
//
// With a FILE or `upload`, --test marks the new image for a trial and resets the board, and --confirm
// waits for the board to answer again and confirms the image that runs; --confirm alone makes the
// staged image permanent and resets.  --baud N (115200), --timeout MS (10000), --tries N (3) and
// --wait SECONDS (120, how long to wait for the board after a reset: the swap of a 340 KB image takes 63 s on the nRF54LM20-DK) are the other options.
//
// The board's [flash] table is read from the toolchain (`novo bsp flash --target BOARD --json`), so
// that this program does not parse the manifest: it tells the size of slot B and of the data region
// and the vendor id of the board's probe, which names its serial port.  The exit status is 0 for
// success, 1 for a code the server answered, 2 for a usage error, 3 when the board could not be
// reached or gave no answer.

use std.bytes
use std.env
use std.fs
use std.json
use std.path
use std.process
use std.time
use smpcli
use smppack
use smptransport

// The facts of a board that this program needs.  `name` is empty when no board was named.
pub struct Board
    name: Str
    vendor: Str
    probes: [Str]
    serial: Str
    slot_b: Int
    data: Int

// The version of the package, which `novo-update --version` prints; the release's smoke step reads it.
pub const VERSION = "0.1.0"

// A serial port of a USB device, as the system describes it.
pub struct Port
    path: Str
    vid: Str
    pid: Str
    serial: Str
    product: Str

// The command line, read.  `link` is "", "serial", "ble" or "tcp"; `addr` is the port, the address
// or the socket, empty when the link is to be found.
pub struct Opts
    var ok: Bool
    var target: Str
    var link: Str
    var addr: Str
    var baud: Int
    var ms: Int
    var tries: Int
    var wait: Int
    var test: Bool
    var confirm: Bool
    var words: [Str]

// A command of the server, with the image index an upload goes to.
pub struct Step
    words: [Str]
    image: Int

@tier(app)
fn usage_to(out: Bool) [io]
    let lines = ["usage: novo update [--target BOARD] [--serial [PORT] | --ble [ADDRESS] | --tcp HOST:PORT] [--test] [--confirm] FILE",
                 "       novo update [--target BOARD] [LINK] list | test HASH | confirm [HASH] | reset | erase | params | echo TEXT",
                 "       novo update [--target BOARD] [LINK] data FILE | file up LOCAL NAME | file down NAME LOCAL | file status NAME | file hash NAME",
                 "       novo update scan [--target BOARD] [--serial | --ble]",
                 "       options: --baud N --timeout MS --tries N --wait SECONDS"]
    for l in lines
        if out
            println(l)
        else
            eprintln(l)

@tier(app)
fn usage() [io]
    usage_to(false)

// Whether `s` is the address of a Bluetooth device: six pairs of hexadecimal digits joined by colons.
@tier(app)
pub fn is_address(s: Str) -> Bool
    if str.len(s) != 17
        return false
    for i in 0..17
        let c = str.byte_at_or(s, i, 0)
        if i % 3 == 2
            if c != ':'
                return false
        else
            let hex = (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
            if not hex
                return false
    true

// Whether `s` names a device file.
@tier(app)
fn is_device(s: Str) -> Bool
    str.starts_with(s, "/dev/")

// The number after a flag, or `fallback` when it is not one.
@tier(app)
fn number(s: Str, fallback: Int) -> Int
    str.to_int(s) ?? fallback

// The command line as options.  `ok` is false for a flag that wants a value and has none.
@tier(app)
pub fn parse(args: [Str]) -> Opts
    var o = Opts { ok: true, target: "", link: "", addr: "", baud: 115200, ms: 10000, tries: 3, wait: 120,
                   test: false, confirm: false, words: [] }
    var i = 0
    for _k in 0..args.len() + 1
        if i >= args.len()
            break
        let a = args[i]
        let next = if i + 1 < args.len() then args[i + 1] else ""
        let has_next = i + 1 < args.len()
        if a == "--serial"
            o.link = "serial"
            if has_next and is_device(next)
                o.addr = next
                i = i + 1
        else if a == "--ble"
            o.link = "ble"
            if has_next and is_address(next)
                o.addr = next
                i = i + 1
        else if a == "--test"
            o.test = true
        else if a == "--confirm"
            o.confirm = true
        else if a == "--target" or a == "--tcp" or a == "--baud" or a == "--timeout" or a == "--tries" or a == "--wait"
            if not has_next
                o.ok = false
                break
            if a == "--target"
                o.target = next
            else if a == "--tcp"
                o.link = "tcp"
                o.addr = next
            else if a == "--baud"
                o.baud = number(next, 115200)
            else if a == "--timeout"
                o.ms = number(next, 10000)
            else if a == "--tries"
                o.tries = number(next, 3)
            else
                o.wait = number(next, 120)
            i = i + 1
        else if str.starts_with(a, "--target=")
            o.target = str.slice(a, 9, str.len(a))
        else if str.starts_with(a, "--serial=")
            o.link = "serial"
            o.addr = str.slice(a, 9, str.len(a))
        else if str.starts_with(a, "--ble=")
            o.link = "ble"
            o.addr = str.slice(a, 6, str.len(a))
        else if str.starts_with(a, "--tcp=")
            o.link = "tcp"
            o.addr = str.slice(a, 6, str.len(a))
        else
            list.push(o.words, a)
        i = i + 1
    o

// The board, from the JSON that `novo bsp flash --json` prints.  `ok` is false for text that is none.
@tier(app)
pub fn board_of(text: Str) -> ?Board [io]
    match json.parse(text)
        None    => None
        Some(v) =>
            let name = json.get_str(v, "board") ?? ""
            var vendor = ""
            var probes: [Str] = []
            for item in json.get_list(v, "probe") ?? []
                let id = json.to_str(item) ?? ""
                list.push(probes, id)
                if vendor == ""
                    vendor = str.split(id, ":")[0]
            var slot_b = 0
            var data = 0
            match json.get(v, "regions")
                None    => ()
                Some(r) =>
                    match json.get(r, "slot_b")
                        None    => ()
                        Some(b) => slot_b = json.get_int(b, "bytes") ?? 0
                    match json.get(r, "data")
                        None    => ()
                        Some(d) => data = json.get_int(d, "bytes") ?? 0
            Some(Board { name: name, vendor: vendor, probes: probes, serial: probe_serial(), slot_b: slot_b, data: data })

// The serial number of the probe `NOVO_PROBE` names (`VID:PID:SERIAL`, as `novo flash` reads it), or "".
@tier(app)
fn probe_serial() -> Str [io]
    let parts = str.split(env.get("NOVO_PROBE") ?? "", ":")
    if parts.len() == 3
        return parts[2]
    ""

// The toolchain that started this program, or the one on PATH.
@tier(app)
fn toolchain() -> Str [io]
    let named = env.get("NOVO") ?? ""
    if named != ""
        return named
    "novo"

// Whether every character of `s` is one a shell passes through unquoted: a letter, a digit, `_`, `-` or `.`.
@tier(app)
fn plain_name(s: Str) -> Bool
    for i in 0..str.len(s)
        let c = str.byte_at_or(s, i, 0)
        let ok = (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '-' or c == '.'
        if not ok
            return false
    true

// `s` as one word of a shell command, in single quotes.
@tier(app)
fn shell_quote(s: Str) -> Str
    "'" + str.replace(s, "'", "'\\''") + "'"

// The board named by `--target`, read from the toolchain.  None when the toolchain refuses it.
@tier(app)
fn board_named(target: Str) -> ?Board [io]
    if target == ""
        return Some(Board { name: "", vendor: "", probes: [], serial: probe_serial(), slot_b: 0, data: 0 })
    if not plain_name(target)
        return None
    match process.run_ok("${shell_quote(toolchain())} bsp flash --target=${target} --json")
        None    => None
        Some(t) => board_of(t)

// The text of the file, trimmed; empty when it cannot be read.
@tier(app)
fn read_trimmed(p: Str) -> Str [fs]
    str.trim(fs.read_or(p, ""))

// The serial ports of USB devices that the system lists under `sys` (`/sys/class/tty`), in the order of
// their names.  A port's description is read from the USB device above its interface.
@tier(app)
pub fn ports(sys: Str, dev: Str) -> [Port] [fs]
    var out: [Port] = []
    var names = fs.read_dir(sys)
    names = list.sort(names)
    for n in names
        if str.starts_with(n, "ttyACM") or str.starts_with(n, "ttyUSB")
            let base = "${sys}/${n}/device/.."
            let vid = read_trimmed("${base}/idVendor")
            if vid != ""
                list.push(out, Port { path: "${dev}/${n}", vid: vid, pid: read_trimmed("${base}/idProduct"),
                                      serial: read_trimmed("${base}/serial"), product: read_trimmed("${base}/product") })
    out

// The ports of the board's probe: those with the serial number `NOVO_PROBE` names, else those whose vendor and product ids are
// one of the board's `[bsp] probe` ids, else those whose vendor id is the board's.  All of them when the board is unknown or none
// matches.
@tier(app)
pub fn ports_of(all: [Port], board: Board) -> [Port]
    var named: [Port] = []
    var exact: [Port] = []
    var ofvendor: [Port] = []
    for p in all
        if board.serial != "" and p.serial == board.serial
            list.push(named, p)
        if list.contains(board.probes, "${p.vid}:${p.pid}")
            list.push(exact, p)
        if board.vendor != "" and p.vid == board.vendor
            list.push(ofvendor, p)
    if named.len() > 0
        return named
    if exact.len() > 0
        return exact
    if ofvendor.len() > 0
        return ofvendor
    all[:]

// One line for a port.
@tier(app)
pub fn port_line(p: Port) -> Str
    "${p.path}  ${p.vid}:${p.pid}  ${p.product}  ${p.serial}"

// The lines of a scan, "name address rssi", as the addresses they hold.
@tier(app)
pub fn addresses_of(lines: [Str]) -> [Str]
    var out: [Str] = []
    for l in lines
        for w in str.split(l, " ")
            if is_address(w)
                list.push(out, w)
    out

// The program that reaches a device over Bluetooth: `NOVO_UPDATE_BLE`, else `novo-update-ble` beside the
// toolchain, else the name, which the system looks up on PATH.
@tier(app)
fn relay_program() -> Str [io, fs]
    let named = env.get("NOVO_UPDATE_BLE") ?? ""
    if named != ""
        return named
    let novo = env.get("NOVO") ?? ""
    if novo != ""
        let beside = path.join(path.dirname(novo), "novo-update-ble")
        if fs.exists(beside)
            return beside
    "novo-update-ble"

// The socket of the bridge in front of the Controller the relay uses.
@tier(app)
fn hci_socket() -> Str [io]
    let named = env.get("NOVO_HCI_SOCKET") ?? ""
    if named != ""
        return named
    "/tmp/novo_hci.sock"

// The lines the relay prints in a scan.
@tier(app)
fn scan_lines() -> [Str] [io, fs]
    var lines: [Str] = []
    match smptransport.spawn_pipe([relay_program(), hci_socket(), "scan"])
        None       => ()
        Some(pipe) =>
            var line = ""
            for _b in 0..100000
                let c = pipe.wire.recv(20000)
                if c < 0
                    break
                if c == '\n'
                    if line != ""
                        list.push(lines, line)
                    line = ""
                else
                    line = line + str.from_char(c)
            proc.close(pipe.wire.pid)
    lines

// Lists the devices that advertise the service and answers their addresses.
@tier(app)
fn scan_ble() -> [Str] [io, fs]
    let lines = scan_lines()
    for l in lines
        println(l)
    addresses_of(lines)

// The hash of the image in `file`, hexadecimal: bytes 0x20 to 0x3F of the NOVB header, in a package as well.
@tier(app)
pub fn image_hash(file: Bytes) -> Str
    let img = smppack.unwrap(file)
    bytes.to_hex(bytes.slice(img, 0x20, 0x40))

// The hash of the image in the file `path`, or "" when the file cannot be read.
@tier(app)
pub fn file_hash(path: Str) -> Str [fs]
    match fs.read_bytes(path)
        None    => ""
        Some(f) => image_hash(f)

// The steps for the words after the options.  Empty when the words are none this program knows.
@tier(app)
pub fn steps_of(w: [Str], o: Opts) -> [Step]
    if w.len() == 0
        return []
    var verb = w[0]
    var rest = w[:]
    if verb == "upload" or verb == "data" or verb == "file" or verb == "list" or verb == "test" or verb == "confirm"
       or verb == "reset" or verb == "erase" or verb == "params" or verb == "echo"
        rest = w[1:w.len()]
    else
        verb = "upload"
    if verb == "list" or verb == "erase"
        return [Step { words: ["image", verb], image: 0 }]
    if verb == "params" or verb == "reset"
        return [Step { words: [verb], image: 0 }]
    if verb == "echo" and rest.len() >= 1
        return [Step { words: ["echo", rest[0]], image: 0 }]
    if verb == "test" and rest.len() >= 1
        return [Step { words: ["image", "test", rest[0]], image: 0 }]
    if verb == "confirm"
        var named = ["image", "confirm"]
        if rest.len() >= 1
            list.push(named, rest[0])
        return [Step { words: named, image: 0 }]
    if verb == "data" and rest.len() >= 1
        return [Step { words: ["image", "upload", rest[0]], image: 1 }]
    if verb == "file" and rest.len() >= 1
        var named = ["fs"]
        for r in rest
            if r == "up" and named.len() == 1
                list.push(named, "upload")
            else if r == "down" and named.len() == 1
                list.push(named, "download")
            else
                list.push(named, r)
        return [Step { words: named, image: 0 }]
    if verb == "upload" and rest.len() >= 1
        return [Step { words: ["image", "upload", rest[0]], image: 0 }]
    []

// The checks before the link is opened: the file of an upload can be read and, for a named board, an image
// fits slot B and a data image is the size of the region.  Answers the sentence for a refusal, or "".
@tier(app)
pub fn refusal(s: [Step], b: Board) -> Str [fs]
    for st in s
        if st.words.len() >= 3 and st.words[1] == "upload"
            match fs.read_bytes(st.words[2])
                None    => return "cannot read ${st.words[2]}"
                Some(f) =>
                    if b.name != "" and st.image == 0
                        let n = bytes.len(smppack.unwrap(f))
                        if b.slot_b > 0 and n > b.slot_b
                            return "${st.words[2]} is ${n} bytes, and slot B of ${b.name} holds ${b.slot_b}"
                    if b.name != "" and st.image == 1
                        let n = bytes.len(f)
                        if b.data > 0 and n != b.data
                            return "${st.words[2]} is ${n} bytes, and the data region of ${b.name} is ${b.data}"
    ""

// Runs the steps over the transport until one fails.  Answers the code of the first that does.
@tier(app)
pub fn execute<T: Transport[e]>(t: T, s: [Step], ms: Int, tries: Int) -> Int [io, fs, e, mutate]
    for st in s
        let rc = smpcli.command_for(t, st.words, st.image, ms, tries)
        if rc != 0
            return rc
    0

// The code of "the board cannot be reached", which `over_link` answers after it has said why.
const UNREACHED = 0 - 3

// Opens the link the options name, runs the steps over it and closes it.  Answers the code of the first
// step that fails (0 when none does, -1 when no answer came), or UNREACHED.
@tier(app)
fn over_link(o: Opts, addr: Str, s: [Step], ms: Int, tries: Int) -> Int [io, fs, net, mutate]
    if o.link == "serial"
        match smptransport.open_serial(addr, o.baud)
            None    =>
                eprintln("novo update: cannot open ${addr}")
                return UNREACHED
            Some(t) =>
                let rc = execute(t, s, ms, tries)
                fs.close(t.wire.fd)
                return rc
    if o.link == "tcp"
        let parts = str.split(addr, ":")
        if parts.len() != 2
            eprintln("novo update: ${addr} is no HOST:PORT")
            return UNREACHED
        match smptransport.connect(parts[0], number(parts[1], 0), 3000)
            None    =>
                eprintln("novo update: cannot connect to ${addr}")
                return UNREACHED
            Some(t) =>
                let rc = execute(t, s, ms, tries)
                net.close(t.wire.sock)
                return rc
    match smptransport.spawn_pipe([relay_program(), hci_socket(), "stdio", addr])
        None    =>
            eprintln("novo update: cannot start ${relay_program()}")
            return UNREACHED
        Some(t) =>
            let rc = execute(t, s, ms, tries)
            proc.close(t.wire.pid)
            rc

// The exit status for the code of `over_link`.
@tier(app)
pub fn exit_of(rc: Int) -> Int [io]
    if rc == UNREACHED
        return 3
    smpcli.status(rc)

// The serial port to use: the one named, or the one there is.  "" when it must be chosen, after a listing.
@tier(app)
fn choose_port(o: Opts, b: Board, sys: Str, dev: Str) -> Str [io, fs]
    if o.addr != ""
        return o.addr
    let found = ports_of(ports(sys, dev), b)
    for p in found
        println(port_line(p))
    if found.len() == 1
        return found[0].path
    if found.len() == 0
        eprintln("novo update: no serial port of a USB board is attached")
    else
        eprintln("novo update: name one of these ports with --serial PORT")
    ""

// The device to use: the one named, or the one that advertises the service.  "" when it must be chosen.
@tier(app)
fn choose_device(o: Opts) -> Str [io, fs]
    if o.addr != ""
        return o.addr
    let found = scan_ble()
    if found.len() == 1
        return found[0]
    if found.len() == 0
        eprintln("novo update: no device advertises the SMP service")
    else
        eprintln("novo update: name one of these devices with --ble ADDRESS")
    ""

// The address of the link to use, found by a listing when the options did not name it.  "" on failure.
@tier(app)
fn choose_link(o: Opts, b: Board, sys: Str, dev: Str) -> Str [io, fs]
    if o.link == "serial"
        return choose_port(o, b, sys, dev)
    if o.link == "ble"
        return choose_device(o)
    o.addr

// The steps of an upload with --test and --confirm: what goes before the board restarts, whether it
// restarts, and what is done once it answers again.
@tier(app)
pub fn flow(first: [Step], digest: Str, o: Opts) -> [[Step]]
    var one = first[:]
    if digest == "" or (not o.test and not o.confirm)
        return [one]
    if o.test
        list.push(one, Step { words: ["image", "test", digest], image: 0 })
    else
        list.push(one, Step { words: ["image", "confirm", digest], image: 0 })
    list.push(one, Step { words: ["reset"], image: 0 })
    if o.test and o.confirm
        return [one, [Step { words: ["image", "confirm"], image: 0 }]]
    [one]

// Waits for the board to answer a list after a reset, for at most `o.wait` seconds.  An attempt may take as long as
// `o.ms`: over Bluetooth it holds the scan for the device and the connection, a few seconds before the first request goes
// out, so an attempt of one second never saw an answer.  The seconds are counted on the clock, not by the attempts.
@tier(app)
fn wait_for_board(o: Opts, addr: Str) -> Bool [io, fs, net, time, mutate]
    let t0 = time.ticks_us()
    for _s in 0..o.wait
        time.sleep(1.0)
        if over_link(o, addr, [Step { words: ["image", "list"], image: 0 }], o.ms, 1) == 0
            return true
        if (time.ticks_us() - t0) / 1000000 >= o.wait
            return false
    false

// The `scan` verb: the ports or the devices, listed.
@tier(app)
fn scan(o: Opts, b: Board, sys: Str, dev: Str) -> Int [io, fs]
    if o.link == "ble"
        let found = scan_ble()
        if found.len() == 0
            return 3
        return 0
    let found = ports_of(ports(sys, dev), b)
    for p in found
        println(port_line(p))
    if found.len() == 0
        return 3
    0

// The program: the arguments, without the program's name, to its exit status.  `sys` is where the
// system describes its serial ports and `dev` where their device files are.
@tier(app)
pub fn run_in(args: [Str], sys: Str, dev: Str) -> Int [io, fs, net, time, mutate]
    if args.len() == 1 and (args[0] == "--version" or args[0] == "version")
        println("novo-update ${VERSION}")
        return 0
    if args.len() == 1 and (args[0] == "--help" or args[0] == "-h" or args[0] == "help")
        usage_to(true)
        return 0
    let o = parse(args)
    if not o.ok or o.words.len() == 0
        usage()
        return 2
    match board_named(o.target)
        None    =>
            eprintln("novo update: the toolchain does not know the board ${o.target}, or it has no [flash] table")
            return 2
        Some(b) =>
            if o.words[0] == "scan"
                return scan(o, b, sys, dev)
            if o.link == ""
                eprintln("novo update: name the link: --serial [PORT], --ble [ADDRESS] or --tcp HOST:PORT")
                return 2
            let s = steps_of(o.words, o)
            if s.len() == 0
                usage()
                return 2
            let why = refusal(s, b)
            if why != ""
                eprintln("novo update: ${why}")
                return 2
            let addr = choose_link(o, b, sys, dev)
            if addr == ""
                return 3
            // An upload with --test or --confirm is the upload, the marks, the restart and the confirmation.
            var digest = ""
            if s.len() == 1 and s[0].image == 0 and s[0].words.len() == 3 and s[0].words[1] == "upload"
                digest = file_hash(s[0].words[2])
            let parts = flow(s, digest, o)
            let rc = over_link(o, addr, parts[0], o.ms, o.tries)
            if rc != 0 or parts.len() == 1
                return exit_of(rc)
            if not wait_for_board(o, addr)
                eprintln("novo update: the board did not answer within ${o.wait} seconds of its restart")
                return 3
            exit_of(over_link(o, addr, parts[1], o.ms, o.tries))

// `run_in` on the system's own description of its serial ports.
@tier(app)
pub fn run(args: [Str]) -> Int [io, fs, net, time, mutate]
    run_in(args, "/sys/class/tty", "/dev")
