// update: `novo update`, the command that updates a board over SMP.
//
//   novo update [--target BOARD] [LINK] [OPTIONS] FILE
//   novo update [--target BOARD] [LINK] [OPTIONS] VERB [ARGUMENTS]
//   novo update scan [--target BOARD] [--serial | --ble]
//
// LINK says how the board is reached:
//
//   --serial [PORT]   the board's serial port, in the console framing of SMP.  Without a PORT the
//                     serial ports of attached USB boards are listed, and the one there is, is used.
//   --ble [ADDRESS]   the SMP service of a device over Bluetooth Low Energy.  The command runs the program
//                     `novo-update-ble` (noble-examples, pc/update_ble.nv) with its own command line: that program is a
//                     Central through a Controller (`run_central` below) and carries the commands over `smpgatt`, with no
//                     relay process between.  Without an ADDRESS it scans for devices that advertise the service, lists
//                     them, and uses the one there is.
//   --tcp HOST:PORT   a server on a socket, such as mcumgr-nv's host server.
//
// A FILE alone is an upload to the second slot: a NOVB image (`novo build --role=application`
// writes `<name>.img`) or the package `novo image pack` writes.  The VERBs:
//
//   upload FILE       the same, said out
//   data FILE         the file `novofs-tools mk --target` wrote, into the data region (image 1)
//   list              the images the board holds
//   test HASH         marks the image with the hash (hex) for a trial at the next start
//   confirm [HASH]    confirms the image that runs, or makes the staged one permanent
//   reset             the board restarts
//   erase             erases the second slot
//   params, echo TEXT what the server answers about itself; a check of the link
//   file up LOCAL NAME | file down NAME LOCAL | file status NAME | file hash NAME | file close
//                     the files of the board's volume, as far as the server offers them
//
// With a FILE or `upload`, --test marks the new image for a trial and resets the board, and --confirm
// waits for the board to answer again and confirms the image that runs; --confirm alone makes the
// staged image permanent and resets.  The upload with --test and --confirm is the flow of `smpflow`, which the upgrade app of
// a phone runs too: the step that follows is derived from what the board's image list says, so a link that drops and a board
// that restarts are met by trying again.  --baud N (115200), --timeout MS (10000), --tries N (3) and
// --wait SECONDS (120, how long to wait for the board after a reset: the swap of a 340 KB image takes 63 s on the nRF54LM20-DK) are the other options.
//
// The board's [flash] table is read from the toolchain (`novo bsp flash --target BOARD --json`), so
// that this program does not parse the manifest: it tells the size of slot B and of the data region
// and the vendor id of the board's probe, which names its serial port.  The exit status is 0 for
// success, 1 for a code the server answered, 2 for a usage error, 3 when the board could not be
// reached or gave no answer.

use std.bytes
use std.env
use std.fs
use std.json
use std.path
use std.process
use std.time
use central
use smpapi
use smpclient
use smpcli
use smpflow
use smpgatt
use smppack
use smptransport

// The facts of a board that this program needs.  `name` is empty when no board was named.
pub struct Board
    name: Str
    vendor: Str
    probes: [Str]
    serial: Str
    slot_b: Int
    data: Int

// The version of the package, which `novo-update --version` prints; the release's smoke step reads it.
pub const VERSION = "0.1.4"

// A serial port of a USB device, as the system describes it.
pub struct Port
    path: Str
    vid: Str
    pid: Str
    serial: Str
    product: Str

// The command line, read.  `link` is "", "serial", "ble" or "tcp"; `addr` is the port, the address
// or the socket, empty when the link is to be found.
pub struct Opts
    var ok: Bool
    var target: Str
    var link: Str
    var addr: Str
    var baud: Int
    var ms: Int
    var tries: Int
    var wait: Int
    var test: Bool
    var confirm: Bool
    var words: [Str]

// A command of the server, with the image index an upload goes to.
pub struct Step
    words: [Str]
    image: Int

@tier(app)
fn usage_to(out: Bool) [io]
    let lines = ["usage: novo update [--target BOARD] [--serial [PORT] | --ble [ADDRESS] | --tcp HOST:PORT] [--test] [--confirm] FILE",
                 "       novo update [--target BOARD] [LINK] list | test HASH | confirm [HASH] | reset | erase | params | echo TEXT",
                 "       novo update [--target BOARD] [LINK] data FILE | file up LOCAL NAME | file down NAME LOCAL | file status NAME | file hash NAME",
                 "       novo update scan [--target BOARD] [--serial | --ble]",
                 "       options: --baud N --timeout MS --tries N --wait SECONDS"]
    for l in lines
        if out
            println(l)
        else
            eprintln(l)

@tier(app)
fn usage() [io]
    usage_to(false)

// Whether `s` is the address of a Bluetooth device: six pairs of hexadecimal digits joined by colons.
pub @tier(app)
fn is_address(s: Str) -> Bool
    if str.len(s) != 17
        return false
    for i in 0..17
        let c = str.byte_at_or(s, i, 0)
        if i % 3 == 2
            if c != ':'
                return false
        else
            let hex = c >= '0' and c <= '9' or c >= 'a' and c <= 'f' or c >= 'A' and c <= 'F'
            if not hex
                return false
    true

// Whether `s` names a device file.
@tier(app)
fn is_device(s: Str) -> Bool
    str.starts_with(s, "/dev/")

// The number after a flag, or `fallback` when it is not one.
@tier(app)
fn number(s: Str, fallback: Int) -> Int
    str.to_int(s) ?? fallback

// The command line as options.  `ok` is false for a flag that wants a value and has none.
pub @tier(app)
fn parse(args: [Str]) -> Opts
    var o = Opts { ok: true, target: "", link: "", addr: "", baud: 115200, ms: 10000, tries: 3, wait: 120,
                   test: false, confirm: false, words: [] }
    var i = 0
    for _k in 0..args.len() + 1
        if i >= args.len()
            break
        let a = args[i]
        let next = if i + 1 < args.len()
            args[i + 1]
        else
            ""
        let has_next = i + 1 < args.len()
        if a == "--serial"
            o.link = "serial"
            if has_next and is_device(next)
                o.addr = next
                i = i + 1
        else if a == "--ble"
            o.link = "ble"
            if has_next and is_address(next)
                o.addr = next
                i = i + 1
        else if a == "--test"
            o.test = true
        else if a == "--confirm"
            o.confirm = true
        else if a == "--target" or a == "--tcp" or a == "--baud" or a == "--timeout" or a == "--tries" or a == "--wait"
            if not has_next
                o.ok = false
                break
            if a == "--target"
                o.target = next
            else if a == "--tcp"
                o.link = "tcp"
                o.addr = next
            else if a == "--baud"
                o.baud = number(next, 115200)
            else if a == "--timeout"
                o.ms = number(next, 10000)
            else if a == "--tries"
                o.tries = number(next, 3)
            else
                o.wait = number(next, 120)
            i = i + 1
        else if str.starts_with(a, "--target=")
            o.target = str.slice(a, 9, str.len(a))
        else if str.starts_with(a, "--serial=")
            o.link = "serial"
            o.addr = str.slice(a, 9, str.len(a))
        else if str.starts_with(a, "--ble=")
            o.link = "ble"
            o.addr = str.slice(a, 6, str.len(a))
        else if str.starts_with(a, "--tcp=")
            o.link = "tcp"
            o.addr = str.slice(a, 6, str.len(a))
        else
            list.push(o.words, a)
        i = i + 1
    o

// The board, from the JSON that `novo bsp flash --json` prints.  `ok` is false for text that is none.
pub @tier(app)
fn board_of(text: Str) -> ?Board [io]
    match json.parse(text)
        None    => None
        Some(v) =>
            let name = json.get_str(v, "board") ?? ""
            var vendor = ""
            var probes: [Str] = []
            for item in json.get_list(v, "probe") ?? []
                let id = json.to_str(item) ?? ""
                list.push(probes, id)
                if vendor == ""
                    vendor = str.split(id, ":")[0]
            var slot_b = 0
            var data = 0
            match json.get(v, "regions")
                None    => ()
                Some(r) =>
                    match json.get(r, "slot_b")
                        None    => ()
                        Some(b) =>
                            slot_b = json.get_int(b, "bytes") ?? 0
                    match json.get(r, "data")
                        None    => ()
                        Some(d) =>
                            data = json.get_int(d, "bytes") ?? 0
            Some(Board { name: name,
                vendor: vendor,
                probes: probes,
                serial: probe_serial(),
                slot_b: slot_b,
                data: data })

// The serial number of the probe `NOVO_PROBE` names (`VID:PID:SERIAL`, as `novo flash` reads it), or "".
@tier(app)
fn probe_serial() -> Str [io]
    let parts = str.split(env.get("NOVO_PROBE") ?? "", ":")
    if parts.len() == 3
        return parts[2]
    ""

// The toolchain that started this program, or the one on PATH.
@tier(app)
fn toolchain() -> Str [io]
    let named = env.get("NOVO") ?? ""
    if named != ""
        return named
    "novo"

// Whether every character of `s` is one a shell passes through unquoted: a letter, a digit, `_`, `-` or `.`.
@tier(app)
fn plain_name(s: Str) -> Bool
    for i in 0..str.len(s)
        let c = str.byte_at_or(s, i, 0)
        let ok = c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c >= '0' and c <= '9' or c == '_' or c == '-' or c == '.'
        if not ok
            return false
    true

// `s` as one word of a shell command, in single quotes.
@tier(app)
fn shell_quote(s: Str) -> Str
    "'" + str.replace(s, "'", "'\\''") + "'"

// The board named by `--target`, read from the toolchain.  None when the toolchain refuses it.
@tier(app)
fn board_named(target: Str) -> ?Board [io]
    if target == ""
        return Some(Board { name: "", vendor: "", probes: [], serial: probe_serial(), slot_b: 0, data: 0 })
    if not plain_name(target)
        return None
    match process.run_ok("${shell_quote(toolchain())} bsp flash --target=${target} --json")
        None    => None
        Some(t) => board_of(t)

// The text of the file, trimmed; empty when it cannot be read.
@tier(app)
fn read_trimmed(p: Str) -> Str [fs]
    str.trim(fs.read_or(p, ""))

// The serial ports of USB devices that the system lists under `sys` (`/sys/class/tty`), in the order of
// their names.  A port's description is read from the USB device above its interface.
pub @tier(app)
fn ports(sys: Str, dev: Str) -> [Port] [fs]
    var out: [Port] = []
    var names = fs.read_dir(sys)
    names = list.sort(names)
    for n in names
        if str.starts_with(n, "ttyACM") or str.starts_with(n, "ttyUSB")
            let base = "${sys}/${n}/device/.."
            let vid = read_trimmed("${base}/idVendor")
            if vid != ""
                list.push(out, Port { path: "${dev}/${n}", vid: vid, pid: read_trimmed("${base}/idProduct"),
                                      serial: read_trimmed("${base}/serial"), product: read_trimmed("${base}/product") })
    out

// The ports of the board's probe: those with the serial number `NOVO_PROBE` names, else those whose vendor and product ids are
// one of the board's `[bsp] probe` ids, else those whose vendor id is the board's.  All of them when the board is unknown or none
// matches.
pub @tier(app)
fn ports_of(all: [Port], board: Board) -> [Port]
    var named: [Port] = []
    var exact: [Port] = []
    var ofvendor: [Port] = []
    for p in all
        if board.serial != "" and p.serial == board.serial
            list.push(named, p)
        if list.contains(board.probes, "${p.vid}:${p.pid}")
            list.push(exact, p)
        if board.vendor != "" and p.vid == board.vendor
            list.push(ofvendor, p)
    if named.len() > 0
        return named
    if exact.len() > 0
        return exact
    if ofvendor.len() > 0
        return ofvendor
    all[:]

// One line for a port.
pub @tier(app)
fn port_line(p: Port) -> Str
    "${p.path}  ${p.vid}:${p.pid}  ${p.product}  ${p.serial}"

// The lines of a scan, "name address rssi", as the addresses they hold.
pub @tier(app)
fn addresses_of(lines: [Str]) -> [Str]
    var out: [Str] = []
    for l in lines
        for w in str.split(l, " ")
            if is_address(w)
                list.push(out, w)
    out

// The program that carries the command over Bluetooth: `NOVO_UPDATE_BLE`, else `novo-update-ble` beside the
// toolchain, else the name, which the system looks up on PATH.  It is a Central through a Controller and runs `run_central`.
@tier(app)
fn ble_program() -> Str [io, fs]
    let named = env.get("NOVO_UPDATE_BLE") ?? ""
    if named != ""
        return named
    let novo = env.get("NOVO") ?? ""
    if novo != ""
        let beside = path.join(path.dirname(novo), "novo-update-ble")
        if fs.exists(beside)
            return beside
    "novo-update-ble"

// The socket of the bridge in front of the Controller the Bluetooth program uses, or the adapter it opens (`hci0`).
@tier(app)
fn hci_socket() -> Str [io]
    let named = env.get("NOVO_HCI_SOCKET") ?? ""
    if named != ""
        return named
    "/tmp/novo_hci.sock"

// The exit status of a shell that could not start the program.
const NOT_STARTED = 127

// Runs the Bluetooth program with the command line it was given, on this program's own input, output and error, and answers its
// exit status, which is the command's.  3 when the program cannot be started.
@tier(app)
fn through_ble(args: [Str]) -> Int [io, fs]
    let prog = ble_program()
    var cmd = "${shell_quote(prog)} ${shell_quote(hci_socket())}"
    for a in args
        cmd = "${cmd} ${shell_quote(a)}"
    let rc = process.exec(cmd)
    if rc == NOT_STARTED
        eprintln("novo update: cannot start ${prog}")
        return 3
    rc

// The hash of the image in `file`, hexadecimal: bytes 0x20 to 0x3F of the NOVB header, in a package as well; "" for a file that is none.
pub @tier(app)
fn image_hash(file: Bytes) -> Str
    match smpflow.candidate(file)
        None    => ""
        Some(c) => c.hex

// The hash of the image in the file `path`, or "" when the file cannot be read.
pub @tier(app)
fn file_hash(path: Str) -> Str [fs]
    match fs.read_bytes(path)
        None    => ""
        Some(f) => image_hash(f)

// The steps for the words after the options.  Empty when the words are none this program knows.
pub @tier(app)
fn steps_of(w: [Str], o: Opts) -> [Step]
    if w.len() == 0
        return []
    var verb = w[0]
    var rest = w[:]
    if verb == "upload" or verb == "data" or verb == "file" or verb == "list" or verb == "test" or verb == "confirm"
       or verb == "reset" or verb == "erase" or verb == "params" or verb == "echo"
        rest = w[1:w.len()]
    else
        verb = "upload"
    if verb == "list" or verb == "erase"
        return [Step { words: ["image", verb], image: 0 }]
    if verb == "params" or verb == "reset"
        return [Step { words: [verb], image: 0 }]
    if verb == "echo" and rest.len() >= 1
        return [Step { words: ["echo", rest[0]], image: 0 }]
    if verb == "test" and rest.len() >= 1
        return [Step { words: ["image", "test", rest[0]], image: 0 }]
    if verb == "confirm"
        var named = ["image", "confirm"]
        if rest.len() >= 1
            list.push(named, rest[0])
        return [Step { words: named, image: 0 }]
    if verb == "data" and rest.len() >= 1
        return [Step { words: ["image", "upload", rest[0]], image: 1 }]
    if verb == "file" and rest.len() >= 1
        var named = ["fs"]
        for r in rest
            if r == "up" and named.len() == 1
                list.push(named, "upload")
            else if r == "down" and named.len() == 1
                list.push(named, "download")
            else
                list.push(named, r)
        return [Step { words: named, image: 0 }]
    if verb == "upload" and rest.len() >= 1
        return [Step { words: ["image", "upload", rest[0]], image: 0 }]
    []

// The checks before the link is opened: the file of an upload can be read and, for a named board, an image
// fits slot B and a data image is the size of the region.  Answers the sentence for a refusal, or "".
pub @tier(app)
fn refusal(s: [Step], b: Board) -> Str [fs]
    for st in s
        if st.words.len() >= 3 and st.words[1] == "upload"
            match fs.read_bytes(st.words[2])
                None    =>
                    return "cannot read ${st.words[2]}"
                Some(f) =>
                    if b.name != "" and st.image == 0
                        let n = bytes.len(smppack.unwrap(f))
                        if b.slot_b > 0 and n > b.slot_b
                            return "${st.words[2]} is ${n} bytes, and slot B of ${b.name} holds ${b.slot_b}"
                    if b.name != "" and st.image == 1
                        let n = bytes.len(f)
                        if b.data > 0 and n != b.data
                            return "${st.words[2]} is ${n} bytes, and the data region of ${b.name} is ${b.data}"
    ""

// Runs the steps over the transport until one fails.  Answers the code of the first that does.
pub @tier(app)
fn execute<T: Transport[e]>(t: T, s: [Step], ms: Int, tries: Int) -> Int [io, fs, e, mutate]
    for st in s
        let rc = smpcli.command_for(t, st.words, st.image, ms, tries)
        if rc != 0
            return rc
    0

// The code of "the board cannot be reached", which the links answer after they have said why.
const UNREACHED = 0 - 3

// The link of a serial port or a TCP socket, which a flow opens again when the board has restarted.  A struct is a reference, so the
// transport methods, whose receiver is by value, change the link through a local `var`.
struct LinkState
    var ser: ?Framed<DevWire>
    var tcp: ?Framed<TcpWire>
    var lost: Bool

// The serial or TCP link `o` names, as a `Transport` that is also a `Reopen`.
pub struct Relink
    o: Opts
    addr: Str
    st: LinkState

// Opens the link `o` names at `addr`.  Answers whether it is open; the reason is said to the caller.
@tier(app)
fn reach(r: Relink) -> Bool [io, fs, net, mutate]
    var st = r.st
    if r.o.link == "serial"
        match smptransport.open_serial(r.addr, r.o.baud)
            None    =>
                eprintln("novo update: cannot open ${r.addr}")
                return false
            Some(t) =>
                st.ser = Some(t)
                st.lost = false
                return true
    let parts = str.split(r.addr, ":")
    if parts.len() != 2
        eprintln("novo update: ${r.addr} is no HOST:PORT")
        return false
    match smptransport.connect(parts[0], number(parts[1], 0), 3000)
        None    =>
            eprintln("novo update: cannot connect to ${r.addr}")
            false
        Some(t) =>
            st.tcp = Some(t)
            st.lost = false
            true

// Closes what is open.
@tier(app)
fn release(r: Relink) [io, fs, net, mutate]
    var st = r.st
    match st.ser
        Some(t) => fs.close(t.wire.fd)
        None    => ()
    match st.tcp
        Some(t) => net.close(t.wire.sock)
        None    => ()
    st.ser = None
    st.tcp = None

impl Transport[io, fs, net] for Relink
    @tier(app)
    fn send(self, packet: Bytes) -> Bool [io, fs, net, mutate]
        var st = self.st
        var sent = false
        match st.ser
            Some(t) =>
                sent = t.send(packet)
            None    =>
                match st.tcp
                    Some(t) =>
                        sent = t.send(packet)
                    None    => ()
        if not sent
            st.lost = true
        sent

    @tier(app)
    fn recv(self, ms: Int) -> ?Bytes [io, fs, net, mutate]
        let st = self.st
        match st.ser
            Some(t) => t.recv(ms)
            None    =>
                match st.tcp
                    Some(t) => t.recv(ms)
                    None    => None

impl Reopen[io, fs, net] for Relink
    @tier(app)
    fn lost(self) -> Bool
        self.st.lost

    @tier(app)
    fn reopen(self, ms: Int) -> Bool [io, fs, net, mutate]
        release(self)
        reach(self)

// The link of a serial port or a socket, open: None when it cannot be (the reason is said).
@tier(app)
fn relink(o: Opts, addr: Str) -> ?Relink [io, fs, net, mutate]
    let r = Relink { o: o, addr: addr, st: LinkState { ser: None, tcp: None, lost: true } }
    if reach(r)
        return Some(r)
    None

// Opens the link the options name, runs the steps over it and closes it.  Answers the code of the first
// step that fails (0 when none does, -1 when no answer came), or UNREACHED.
@tier(app)
fn over_link(o: Opts, addr: Str, s: [Step], ms: Int, tries: Int) -> Int [io, fs, net, mutate]
    match relink(o, addr)
        None    => UNREACHED
        Some(t) =>
            let rc = execute(t, s, ms, tries)
            release(t)
            rc

// The exit status for the code of `over_link`.
pub @tier(app)
fn exit_of(rc: Int) -> Int [io]
    if rc == UNREACHED
        return 3
    smpcli.status(rc)

// The serial port to use: the one named, or the one there is.  "" when it must be chosen, after a listing.
@tier(app)
fn choose_port(o: Opts, b: Board, sys: Str, dev: Str) -> Str [io, fs]
    if o.addr != ""
        return o.addr
    let found = ports_of(ports(sys, dev), b)
    for p in found
        println(port_line(p))
    if found.len() == 1
        return found[0].path
    if found.len() == 0
        eprintln("novo update: no serial port of a USB board is attached")
    else
        eprintln("novo update: name one of these ports with --serial PORT")
    ""

// The steps of an upload that does not wait for the board: with --test the image is marked for a trial and the board restarts, with
// --confirm alone it is made permanent and the board restarts.  An upload with both is the flow of `smpflow` (`run_flow`), which waits
// for the board and confirms; it is not a list of steps.
pub @tier(app)
fn flow(first: [Step], digest: Str, o: Opts) -> [[Step]]
    var one = first[:]
    if digest == "" or not o.test and not o.confirm
        return [one]
    if o.test
        list.push(one, Step { words: ["image", "test", digest], image: 0 })
    else
        list.push(one, Step { words: ["image", "confirm", digest], image: 0 })
    list.push(one, Step { words: ["reset"], image: 0 })
    [one]

// The exit status of a flow that ended with `rep`, and what it says on the way out.  `size` is the bytes of the image.
@tier(app)
fn report_exit(rep: smpflow.Report, o: Opts, size: Int) -> Int [io]
    if rep.requests > 0
        println("uploaded ${size} bytes in ${rep.requests} requests")
    match rep.outcome
        Outcome.Done             => 0
        Outcome.AlreadyInstalled => 0
        Outcome.Refused          =>
            eprintln("novo update: ${rep.why}")
            2
        Outcome.NeverReturned    =>
            eprintln("novo update: the board did not answer within ${o.wait} seconds of its restart")
            3
        Outcome.Reverted         =>
            eprintln("novo update: ${rep.why}")
            1
        Outcome.Failed           =>
            eprintln("novo update: ${rep.why}")
            if rep.code > 0
                return 1
            3
        _                        =>
            eprintln("novo update: ${rep.why}")
            3

// Runs the flow of `smpflow` over `t`: the image of `file` is uploaded (from the offset the board kept), marked for a trial, the
// board is restarted and waited for for `o.wait` seconds, and the image that runs is confirmed.  Prints the upload and the list
// of the images when it is done, as the steps did.  The exit status.
@tier(app)
fn run_flow<T: Transport[e] + Reopen[f]>(t: T, file: Bytes, o: Opts,
                                         b: Board) -> Int [io, fs, e, f, time, mutate]
    match smpflow.candidate(file)
        None    =>
            eprintln("novo update: the file is neither a NOVB image nor a package that holds one")
            2
        Some(c) =>
            let base = smpflow.plan(Mode.TestAndConfirm, smpapi.options(o.ms, o.tries))
            let plan = Plan { mode: base.mode,
                call: base.call,
                wait_ms: o.wait * 1000,
                link_ms: base.link_ms,
                poll_ms: base.poll_ms,
                poll_max_ms: base.poll_max_ms,
                slot_bytes: b.slot_b,
                refuse_older: false,
                retries: base.retries }
            let rep = smpflow.run(t, file, plan, smpflow.new_state(c, Mode.TestAndConfirm), smpapi.Silent { id: 0 }, smpflow.Quiet { id: 0 },
                smpflow.System { id: 0 })
            let rc = report_exit(rep, o, c.size)
            if rc != 0
                return rc
            smpcli.status(smpclient.image_list(t, o.ms, o.tries))

// The flow over the serial port or the socket the options name.
@tier(app)
fn flow_over_link(o: Opts, addr: Str, file: Str, b: Board) -> Int [io, fs, net, time, mutate]
    match fs.read_bytes(file)
        None    =>
            eprintln("novo update: cannot read ${file}")
            2
        Some(f) =>
            match relink(o, addr)
                None    => 3
                Some(t) =>
                    let rc = run_flow(t, f, o, b)
                    release(t)
                    rc

// What the words of the command ask for, checked before a link is opened: the steps, the hash of an image uploaded with --test or
// --confirm, and, when the command is to end here, its exit status (-1 when it is not).
struct Job
    rc: Int
    steps: [Step]
    digest: Str

// The job of the words `o` holds, for the board `b`.
@tier(app)
fn job_of(o: Opts, b: Board) -> Job [io, fs]
    let s = steps_of(o.words, o)
    if s.len() == 0
        usage()
        return Job { rc: 2, steps: [], digest: "" }
    let why = refusal(s, b)
    if why != ""
        eprintln("novo update: ${why}")
        return Job { rc: 2, steps: s, digest: "" }
    // An upload with --test or --confirm is the upload, the marks, the restart and the confirmation.
    var digest = ""
    if s.len() == 1 and s[0].image == 0 and s[0].words.len() == 3 and s[0].words[1] == "upload"
        digest = file_hash(s[0].words[2])
    Job { rc: 0 - 1, steps: s, digest: digest }

// Whether the options ask for the flow of `smpflow`: an upload of an image with --test and --confirm.
@tier(app)
fn wants_flow(o: Opts, j: Job) -> Bool
    j.digest != "" and o.test and o.confirm

// The `scan` verb: the ports or the devices, listed.
@tier(app)
fn scan(o: Opts, b: Board, sys: Str, dev: Str) -> Int [io, fs]
    let found = ports_of(ports(sys, dev), b)
    for p in found
        println(port_line(p))
    if found.len() == 0
        return 3
    0

// The program: the arguments, without the program's name, to its exit status.  `sys` is where the
// system describes its serial ports and `dev` where their device files are.
pub @tier(app)
fn run_in(args: [Str], sys: Str, dev: Str) -> Int [io, fs, net, time, mutate]
    if args.len() == 1 and (args[0] == "--version" or args[0] == "version")
        println("novo-update ${VERSION}")
        return 0
    if args.len() == 1 and (args[0] == "--help" or args[0] == "-h" or args[0] == "help")
        usage_to(true)
        return 0
    let o = parse(args)
    if not o.ok or o.words.len() == 0
        usage()
        return 2
    match board_named(o.target)
        None    =>
            eprintln("novo update: the toolchain does not know the board ${o.target}, or it has no [flash] table")
            return 2
        Some(b) =>
            if o.link == "ble"
                return through_ble(args)
            if o.words[0] == "scan"
                return scan(o, b, sys, dev)
            if o.link == ""
                eprintln("novo update: name the link: --serial [PORT], --ble [ADDRESS] or --tcp HOST:PORT")
                return 2
            let j = job_of(o, b)
            if j.rc >= 0
                return j.rc
            let addr = choose_port_or_addr(o, b, sys, dev)
            if addr == ""
                return 3
            if wants_flow(o, j)
                return flow_over_link(o, addr, j.steps[0].words[2], b)
            let parts = flow(j.steps, j.digest, o)
            exit_of(over_link(o, addr, parts[0], o.ms, o.tries))

// The address of the link to use for a serial port or a socket: named, or found by a listing.  "" on failure.
@tier(app)
fn choose_port_or_addr(o: Opts, b: Board, sys: Str, dev: Str) -> Str [io, fs]
    if o.link == "serial"
        return choose_port(o, b, sys, dev)
    o.addr

// `run_in` on the system's own description of its serial ports.
pub @tier(app)
fn run(args: [Str]) -> Int [io, fs, net, time, mutate]
    run_in(args, "/sys/class/tty", "/dev")

// ── Bluetooth ────────────────────────────────────────────────────────────────────────────────────────────────────────────────

// How long a scan for the devices that advertise the service lasts, in seconds.
const SCAN_SECONDS = 10

// Scans for `seconds` seconds for the devices that advertise the SMP service and prints one line for each, "name address rssi".
// Answers their addresses.
@tier(app)
fn scan_central<C: GattCentral[e]>(c: C, seconds: Int) -> [Str] [e, io, time, mutate]
    var lines: [Str] = []
    match c.scan_start(central.scan_service(smpgatt.service_uuid()))
        Some(x) =>
            eprintln("novo update: cannot scan: ${x.message()}")
            return []
        None    => ()
    let t0 = time.ticks_us()
    var seen: [Str] = []
    for _i in 0..10000000
        match c.next_event(100)
            Some(ScanResult(p, rssi, name, _)) =>
                if not list.contains(seen, central.peer_key(p))
                    list.push(seen, central.peer_key(p))
                    let line = "${name} ${central.peer_key(p)} ${rssi}"
                    println(line)
                    list.push(lines, line)
            _                                  => ()
        if (time.ticks_us() - t0) / 1000000 >= seconds
            break
    c.scan_stop()
    addresses_of(lines)

// The device to use: the one named, or the one that advertises the service.  "" when it must be chosen.
@tier(app)
fn choose_device<C: GattCentral[e]>(c: C, o: Opts, seconds: Int) -> Str [e, io, time, mutate]
    if o.addr != ""
        return o.addr
    let found = scan_central(c, seconds)
    if found.len() == 1
        return found[0]
    if found.len() == 0
        eprintln("novo update: no device advertises the SMP service")
    else
        eprintln("novo update: name one of these devices with --ble ADDRESS")
    ""

// The upload of `file` with --test and --confirm over the SMP service of `addr`.
@tier(app)
fn flow_over_central<C: GattCentral[e]>(c: C, addr: Str, file: Str, o: Opts,
                                        b: Board) -> Int [e, io, fs, hw, net, async, time, mutate]
    match fs.read_bytes(file)
        None    =>
            eprintln("novo update: cannot read ${file}")
            2
        Some(f) =>
            match smpgatt.open(c, central.peer(addr), smpgatt.options())
                Err(x)   =>
                    eprintln("novo update: cannot reach ${addr}: ${x.message()}")
                    3
                Ok(link) =>
                    let rc = run_flow(link, f, o, b)
                    link.close()
                    rc

// The steps over the SMP service of `addr`.
@tier(app)
fn steps_over_central<C: GattCentral[e]>(c: C, addr: Str, s: [Step],
                                         o: Opts) -> Int [e, io, fs, hw, net, async, time, mutate]
    match smpgatt.open(c, central.peer(addr), smpgatt.options())
        Err(x)   =>
            eprintln("novo update: cannot reach ${addr}: ${x.message()}")
            exit_of(UNREACHED)
        Ok(link) =>
            let rc = execute(link, s, o.ms, o.tries)
            link.close()
            exit_of(rc)

// The program that `novo update --ble` runs: the command line, with no program name, over the Central `c`, which reaches devices through a
// Controller (the noble Host, in noble-examples).  The commands are those of `run_in`; the link is the SMP service of the device that
// `--ble ADDRESS` names, or that the scan finds when there is one device.  The exit status.
pub @tier(app)
fn run_central<C: GattCentral[e]>(args: [Str],
                                  c: C) -> Int [e, io, fs, hw, net, async, time, mutate]
    run_central_in(args, c, SCAN_SECONDS)

// `run_central` with the seconds a scan lasts.
pub @tier(app)
fn run_central_in<C: GattCentral[e]>(args: [Str], c: C,
                                     seconds: Int) -> Int [e, io, fs, hw, net, async, time, mutate]
    let o = parse(args)
    if not o.ok or o.words.len() == 0
        usage()
        return 2
    match board_named(o.target)
        None    =>
            eprintln("novo update: the toolchain does not know the board ${o.target}, or it has no [flash] table")
            return 2
        Some(b) =>
            if o.link != "ble"
                eprintln("novo update: this program carries the commands over Bluetooth: name the link with --ble [ADDRESS]")
                return 2
            if o.words[0] == "scan"
                if scan_central(c, seconds).len() == 0
                    return 3
                return 0
            let j = job_of(o, b)
            if j.rc >= 0
                return j.rc
            let addr = choose_device(c, o, seconds)
            if addr == ""
                return 3
            if wants_flow(o, j)
                return flow_over_central(c, addr, j.steps[0].words[2], o, b)
            let parts = flow(j.steps, j.digest, o)
            steps_over_central(c, addr, parts[0], o)
