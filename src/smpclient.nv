// smpclient: the commands of the `smp-client-nv` program, which print what smpapi.nv returns.
//
// Each command sends its request through a `Transport` (smptransport.nv) and prints what the response holds: the images, the
// length of a file, the CRC-32 of one.  A request that is not answered within the timeout is sent again, up to `tries` times; a
// response that does not belong to the request, by its sequence number, is ignored.  The logic is smpapi.nv's, and a program that
// wants the values and not the lines calls that module.
//
// Every command answers a code: 0 for success, the server's code for a request it refused, and a negative number when the
// command did not come to an answer (the `E_` codes of smpapi.nv; -1 when no response arrived).

use std.bytes
use std.fs
use smphdr
use smpapi
use smptransport

// The code of the result of a command that has no value to print.
@tier(app)
fn code_of_unit(r: Result<Unit, SmpError>) -> Int
    match r
        Ok(_)  => 0
        Err(e) => e.code

@tier(app)
fn flag_text(on: Bool, name: Str) -> Str
    if on
        return " ${name}"
    ""

// Prints the images of a list.
@tier(app)
fn print_slots(slots: [Slot]) [io]
    for s in slots
        println("image=${s.image} slot=${s.slot}")
        println("    version: ${s.version}")
        println("    flags:${flag_text(s.bootable, "bootable")}${flag_text(s.active, "active")}${flag_text(s.confirmed, "confirmed")}${flag_text(s.pending, "pending")}${flag_text(s.permanent, "permanent")}")
        println("    hash: ${bytes.to_hex(s.hash)}")

// Prints the images of the result of a command that answers the list, and answers its code.
@tier(app)
fn code_of_slots(r: Result<[Slot], SmpError>) -> Int [io]
    match r
        Ok(slots) =>
            print_slots(slots)
            0
        Err(e)    => e.code

// Prints `echo`'s answer.
@tier(app)
pub fn echo<T: Transport[e]>(w: T, text: Str, ms: Int, tries: Int) -> Int [io, e, mutate]
    match smpapi.echo(w, text, smpapi.options(ms, tries))
        Ok(back) =>
            println(back)
            0
        Err(e)   => e.code

// Prints the parameters of the server.
@tier(app)
pub fn params<T: Transport[e]>(w: T, ms: Int, tries: Int) -> Int [io, e, mutate]
    match smpapi.params(w, smpapi.options(ms, tries))
        Ok(p)  =>
            println("buf_size ${p.buf_size} buf_count ${p.buf_count}")
            0
        Err(e) => e.code

// Asks the server to reset.
@tier(app)
pub fn reset<T: Transport[e]>(w: T, ms: Int, tries: Int) -> Int [e, mutate]
    code_of_unit(smpapi.reset(w, smpapi.options(ms, tries)))

// Prints the image list.
@tier(app)
pub fn image_list<T: Transport[e]>(w: T, ms: Int, tries: Int) -> Int [io, e, mutate]
    code_of_slots(smpapi.image_list(w, smpapi.options(ms, tries)))

// Marks the image whose hash is `hash` for a test at the next start, or confirms it (`hash` empty confirms the image that runs).
@tier(app)
pub fn image_state<T: Transport[e]>(w: T, hash: Bytes, confirm: Bool, ms: Int, tries: Int) -> Int [io, e, mutate]
    if confirm
        return code_of_slots(smpapi.image_confirm(w, hash, smpapi.options(ms, tries)))
    code_of_slots(smpapi.image_test(w, hash, smpapi.options(ms, tries)))

// Erases the second slot.
@tier(app)
pub fn image_erase<T: Transport[e]>(w: T, ms: Int, tries: Int) -> Int [e, mutate]
    code_of_unit(smpapi.image_erase(w, smpapi.options(ms, tries)))

// Uploads the image `file`, a NOVB image or a package, a request at a time.  `chunk` is the most bytes of the file in a request, 0 for
// the most the buffer holds.  Answers 0, the server's code, or a negative code.  The list is not read afterwards: the next step of a
// flow, `test HASH`, is refused by a server that holds no image with that hash, and `smpapi.image_upload` is the call that checks.
@tier(app)
pub fn image_upload<T: Transport[e]>(w: T, file: Bytes, chunk: Int, ms: Int, tries: Int) -> Int [io, e, mutate]
    image_upload_to(w, 0, file, chunk, ms, tries)

// `image_upload` for the image `image`: 0 is the firmware, 1 the data region, whose file is the one `novofs-tools mk --target` wrote.
@tier(app)
pub fn image_upload_to<T: Transport[e]>(w: T, image: Int, file: Bytes, chunk: Int, ms: Int, tries: Int) -> Int [io, e, mutate]
    let o = smpapi.with_chunk(smpapi.options(ms, tries), chunk)
    match smpapi.image_upload_to(w, image, file, o, Silent { id: 0 })
        Ok(u)  =>
            println("uploaded ${bytes.len(file)} bytes in ${u.requests} requests")
            0
        Err(e) => e.code

// Uploads `file` as the file `name` of the server.
@tier(app)
pub fn fs_upload<T: Transport[e]>(w: T, name: Str, file: Bytes, ms: Int, tries: Int) -> Int [io, e, mutate]
    code_of_unit(smpapi.fs_upload(w, name, file, smpapi.options(ms, tries), Silent { id: 0 }))

// Prints the length of the file `name` of the server.
@tier(app)
pub fn fs_status<T: Transport[e]>(w: T, name: Str, ms: Int, tries: Int) -> Int [io, e, mutate]
    match smpapi.fs_status(w, name, smpapi.options(ms, tries))
        Ok(n)  =>
            println("${name}: ${n} bytes")
            0
        Err(e) => e.code

// Prints the CRC-32 of the file `name` of the server, as eight hexadecimal digits.
@tier(app)
pub fn fs_hash<T: Transport[e]>(w: T, name: Str, ms: Int, tries: Int) -> Int [io, e, mutate]
    match smpapi.fs_hash(w, name, smpapi.options(ms, tries))
        Err(e) => e.code
        Ok(h)  =>
            var hex = ""
            for i in 0..8
                let d = (h.crc32 >> (4 * (7 - i))) & 15
                if d < 10
                    hex = hex + str.from_int(d)
                else
                    hex = hex + str.from_char('a' + d - 10)
            println("${name}: crc32 ${hex} over ${h.len} bytes")
            0

// Asks the server to close the files of a transfer that stalled.
@tier(app)
pub fn fs_close<T: Transport[e]>(w: T, ms: Int, tries: Int) -> Int [e, mutate]
    code_of_unit(smpapi.fs_close(w, smpapi.options(ms, tries)))

// Downloads the file `name` of the server and writes the bytes to `path`.
@tier(app)
pub fn fs_download<T: Transport[e]>(w: T, name: Str, path: Str, ms: Int, tries: Int) -> Int [io, fs, e, mutate]
    match smpapi.fs_download(w, name, smpapi.options(ms, tries), Silent { id: 0 })
        Err(e)   => e.code
        Ok(data) =>
            match fs.open_write(path)
                None     =>
                    return EUNKNOWN
                Some(fd) =>
                    var all: [Int] = []
                    for i in 0..bytes.len(data)
                        list.push(all, bytes.byte_at(data, i) ?? 0)
                    let failed = fs.write_at(fd, 0, all)
                    fs.close(fd)
                    match failed
                        Some(_) =>
                            return EUNKNOWN
                        None    => ()
            println("downloaded ${bytes.len(data)} bytes")
            0
